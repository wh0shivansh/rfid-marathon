# RFID Marathon Management System - Backend Environment Template

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=your-supabase-host.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=strong_password_here
DB_SSL_MODE=require
DB_CONNECTION_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Login Details
# ---------------------------------------------------------------------------
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin@123456
ADMIN_EMAIL=admin@rfid-marathon.local

# ---------------------------------------------------------------------------
# RFID Hub Related
# ---------------------------------------------------------------------------
# These are the plaintext passwords that RFID hubs will use.
# They will be encrypted on server startup and logged as encrypted keys.
# Configure RFID hubs with the encrypted keys shown in server startup logs.
RFID_START_HUB_SECRET=start_hub_english_password_here_min_12_chars
RFID_END_HUB_SECRET=end_hub_english_password_here_min_12_chars

# Grace period for late arrivals (seconds) - candidates can be added during this window after /start
# Default: 120 (2 minutes)
RFID_GRACE_PERIOD_SECONDS=120

# Minimum read count to be considered a valid candidate (prevents ghost hits)
# Default: 3
RFID_MIN_READ_COUNT_TO_LOCK=3

# No-hit timeout to force-lock remaining unlocked candidates (seconds)
# Default: 20
RFID_NO_HIT_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Security Keys
# ---------------------------------------------------------------------------
# 64-hex characters
JWT_SECRET_KEY=change_me_to_secure_hex_64
# Fernet master key (44-char base64). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=change_me_to_fernet_key
# RSA key paths (mounted via volume)
RSA_PUBLIC_KEY_PATH=keys/rsa_public.pem
RSA_PRIVATE_KEY_PATH=keys/rsa_private.pem

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
APP_RELOAD=1

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# ---------------------------------------------------------------------------
# SSL/TLS (for reverse proxy termination; DB SSL enforced by connection string)
# ---------------------------------------------------------------------------
SSL_CERT_PATH=
SSL_KEY_PATH=
