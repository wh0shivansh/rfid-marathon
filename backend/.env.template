# RFID Marathon Management System - Backend Environment Template

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
SUPABASE_DB_HOST=your-supabase-host.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=strong_password_here
DB_SSL_MODE=require
DB_CONNECTION_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------------
# Login Details
# ---------------------------------------------------------------------------
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=Admin@123456
ADMIN_EMAIL=admin@rfid-marathon.local

# ---------------------------------------------------------------------------
# RFID Antenna settings
# ---------------------------------------------------------------------------
RFID_START_SECRET_KEY=start_rfid_antenna_secret_key_which_will_be_sent_as_a_custom_parameter_from_the_rfid_manager_antenna
RFID_END_SECRET_KEY=end_rfid_antenna_secret_key_which_will_be_sent_as_a_custom_parameter_from_the_rfid_manager_antenna

# ---------------------------------------------------------------------------
# Security Keys
# ---------------------------------------------------------------------------
# 64-hex characters
JWT_SECRET_KEY=change_me_to_secure_hex_64
# Fernet master key (44-char base64). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=change_me_to_fernet_key
# RSA key paths (mounted via volume)
RSA_PUBLIC_KEY_PATH=keys/rsa_public.pem
RSA_PRIVATE_KEY_PATH=keys/rsa_private.pem

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_ENV=production

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# ---------------------------------------------------------------------------
# SSL/TLS (for reverse proxy termination; DB SSL enforced by connection string)
# ---------------------------------------------------------------------------
SSL_CERT_PATH=
SSL_KEY_PATH=
