# RFID Marathon Management System - Frontend (.env.template)

# Backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Auth (intentionally stored on client as per requirement)
FRONTEND_USERNAME=admin
FRONTEND_PASSWORD=Admin@123456

# RSA Keys (frontend private key path / inline)
FRONTEND_RSA_PRIVATE_KEY_PATH=keys/frontend_private.pem
FRONTEND_RSA_PUBLIC_KEY_PATH=keys/frontend_public.pem

# SQLite database file (local offline cache)
SQLITE_DB_PATH=rfid_offline.db

# Sync
SYNC_RETRY_INTERVAL_MS=5000
SYNC_MAX_RETRIES=5

# UI
APP_NAME=RFID Marathon Manager
