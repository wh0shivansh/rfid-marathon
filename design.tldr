								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "every time the rfid is scanned. Its task is to first check which"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "race is scheduled for today and store the rfid in that table with"
								}
